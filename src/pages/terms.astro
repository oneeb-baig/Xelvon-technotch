---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import { COMPANY } from '../data/content';
---

<BaseLayout
  title="Terms of Service | Xelvon"
  description="Terms governing the use of the XELVON website and services."
>
  <div class="w-full bg-white">
    <PageHero
      title="Terms of Service"
      subtitle="The terms that govern your use of the XELVON website and our services."
    />

    <section class="w-full bg-white py-14 sm:py-16 lg:py-20">
      <div class="mx-auto w-full max-w-[820px] px-5 sm:px-8 lg:px-14">
        <div class="space-y-10 font-body text-[14px] leading-[1.7] text-[#333333]">
          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">1. Acceptance of terms</h2>
            <p class="mt-3">
              By accessing or using the XELVON website, you agree to these terms. If you do not
              agree, please do not use this website.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">2. Use of the website</h2>
            <p class="mt-3">
              The content on this website is provided for general information about XELVON (Private)
              Limited and its services. You agree not to misuse the website or use it for any
              unlawful purpose.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">3. Services</h2>
            <p class="mt-3">
              Any engagement for cybersecurity, cloud, software or managed IT services is governed
              by a separate written agreement or statement of work. Nothing on this website
              constitutes a binding offer.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">4. Intellectual property</h2>
            <p class="mt-3">
              All content, branding and materials on this website are the property of XELVON
              (Private) Limited and may not be reproduced without prior written consent.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">5. Disclaimer &amp; liability</h2>
            <p class="mt-3">
              This website is provided “as is” without warranties of any kind. To the maximum extent
              permitted by law, XELVON (Private) Limited shall not be liable for any damages arising
              from the use of, or inability to use, this website.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">6. Contact</h2>
            <p class="mt-3">
              Questions about these terms can be sent to{' '}
              <a href={COMPANY.emailHref} class="font-medium text-xelvon-green underline hover:text-xelvon-green-hover">
                {COMPANY.email}
              </a>{' '}
              or by calling{' '}
              <a href={COMPANY.phoneHref} class="font-medium text-xelvon-green underline hover:text-xelvon-green-hover">
                {COMPANY.phoneDisplay}
              </a>
              .
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
