---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import { COMPANY } from '../data/content';
---

<BaseLayout
  title="Privacy Policy | Xelvon"
  description="How XELVON (Private) Limited collects, uses and protects your personal information."
>
  <div class="w-full bg-white">
    <PageHero
      title="Privacy Policy"
      subtitle="How XELVON (Private) Limited collects, uses and protects your personal information."
    />

    <section class="w-full bg-white py-14 sm:py-16 lg:py-20">
      <div class="mx-auto w-full max-w-[820px] px-5 sm:px-8 lg:px-14">
        <div class="space-y-10 font-body text-[14px] leading-[1.7] text-[#333333]">
          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">1. Information we collect</h2>
            <p class="mt-3">
              When you contact us through our website, by phone, WhatsApp or email, we collect the
              details you provide: your name, work email, phone number, the service you are
              interested in, and your message. We also collect basic technical data such as your
              IP address and browser type for security and analytics purposes.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">2. How we use your information</h2>
            <p class="mt-3">
              We use your information solely to respond to your enquiry, provide the services you
              request, and improve our website. We do not sell, rent or trade your personal
              information to third parties.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">3. Data security</h2>
            <p class="mt-3">
              We apply appropriate technical and organisational measures to protect your data
              against unauthorised access, alteration or disclosure. Access to personal data is
              limited to authorised personnel who need it to perform their duties.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">4. Data retention</h2>
            <p class="mt-3">
              We retain enquiry records for as long as needed to handle your request and maintain
              our business relationship, after which they are securely deleted.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">5. Your rights</h2>
            <p class="mt-3">
              You may ask us to access, correct or delete the personal information we hold about
              you at any time by contacting us at{' '}
              <a href={COMPANY.emailHref} class="font-medium text-xelvon-green underline hover:text-xelvon-green-hover">
                {COMPANY.email}
              </a>
              .
            </p>
          </div>

          <div>
            <h2 class="font-heading text-[20px] font-bold text-xelvon-dark">6. Contact</h2>
            <p class="mt-3">
              XELVON (Private) Limited, {COMPANY.address}. Email:{' '}
              <a href={COMPANY.emailHref} class="font-medium text-xelvon-green underline hover:text-xelvon-green-hover">
                {COMPANY.email}
              </a>{' '}
              · Phone:{' '}
              <a href={COMPANY.phoneHref} class="font-medium text-xelvon-green underline hover:text-xelvon-green-hover">
                {COMPANY.phoneDisplay}
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
