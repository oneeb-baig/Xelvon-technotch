---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import SectionEyebrow from '../components/sections/SectionEyebrow.astro';
import RegistrationsGrid from '../components/sections/RegistrationsGrid.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';

const APPROACH_STEPS = [
  {
    number: '1',
    title: 'Assess',
    subtitle: 'Understand your risks and goals',
  },
  {
    number: '2',
    title: 'Design',
    subtitle: 'Secure, scalable architecture',
  },
  {
    number: '3',
    title: 'Deliver',
    subtitle: 'Engineer-led implementation',
  },
  {
    number: '4',
    title: 'Support',
    subtitle: 'Monitor, improve, respond 24/7',
  },
];
---

<BaseLayout title="About XELVON | Cybersecurity, Cloud & Custom Software">
  <div class="w-full bg-white">
    {/* Dark Green Hero */}
    <PageHero
      title="About XELVON"
      subtitle="XELVON is an engineering-led IT company in Lahore that secures, builds and runs technology for businesses across Pakistan."
    />

    {/* OUR APPROACH — 4 Step Cards with Top-Right Circular Number Notch */}
    <section class="w-full bg-white pt-14 pb-6 sm:pt-16 sm:pb-8 lg:pt-20 lg:pb-10">
      <div class="mx-auto w-full max-w-site px-5 sm:px-8 lg:px-14">
        <SectionEyebrow label="OUR APPROACH" />

        <h2 class="mt-3 font-heading text-[28px] font-bold leading-[1.15] text-xelvon-dark sm:text-[32px] lg:text-[36px]">
          How we work on every engagement
        </h2>

        {/* 2x2 on mobile/tablet, 4 columns on desktop */}
        <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-7 sm:gap-x-6 sm:gap-y-8 lg:grid-cols-4 lg:gap-6">
          {APPROACH_STEPS.map((step) => (
            <div class="relative pt-3.5">
              {/* Circular Number Badge with White Cutout Ring */}
              <div
                class="absolute right-0 top-0 z-10 flex h-[38px] w-[38px] items-center justify-center rounded-full bg-xelvon-green font-heading text-[16px] font-bold text-white ring-[6px] ring-white sm:h-[44px] sm:w-[44px] sm:text-[18px] sm:ring-[7px]"
                aria-hidden="true"
              >
                {step.number}
              </div>

              {/* Forest-to-Moss Green Gradient Card */}
              <div class="flex h-full min-h-[116px] flex-col justify-center rounded-[12px] bg-gradient-to-b from-[#23652C] via-[#2C722B] to-[#4A8B23] px-4 py-6 text-white sm:min-h-[138px] sm:px-6 sm:py-8">
                <h3 class="font-heading text-[20px] font-bold leading-tight text-white sm:text-[24px] lg:text-[25px]">
                  {step.title}
                </h3>
                <p class="mt-1.5 font-body text-[11px] leading-snug text-white/90 sm:mt-2 sm:text-[12.5px]">
                  {step.subtitle}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Shared Registrations & Affiliations Grid */}
    <RegistrationsGrid />

    {/* Bottom CTA Banner */}
    <CtaBanner
      title="Work with our engineers"
      subtitle="Tell us about your project and we'll reply within one business day."
      buttonText="Contact us"
      buttonHref="/contact"
    />
  </div>
</BaseLayout>
