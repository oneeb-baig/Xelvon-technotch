---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Xelvon | Cybersecurity, Cloud & Custom Software' } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/assets/x_icon_lime.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f6b2c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="XELVON (Private) Limited" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <!-- Preload the above-the-fold hero image -->
    <link rel="preload" as="image" href="/assets/d2_hero.webp" type="image/webp" fetchpriority="high" />
    <!-- Google Fonts: Source Sans 3 & Inter (loaded non-blocking to avoid render delay) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;0,800;1,600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;0,800;1,600&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body class="bg-xelvon-bg text-xelvon-dark font-body antialiased selection:bg-xelvon-lime selection:text-xelvon-dark">
    <div class="min-h-screen flex flex-col bg-xelvon-bg text-xelvon-dark selection:bg-xelvon-lime selection:text-xelvon-dark">
      <Navbar />
      <main class="flex-1 w-full">
        <slot />
      </main>
      <Footer year={year} />
    </div>

    <script>
      // Replicates the React app's ScrollToHash: on every full page load,
      // smooth-scroll to the hash target if present, otherwise to top.
      const hash = window.location.hash;
      if (hash) {
        const target = document.getElementById(hash.replace('#', ''));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      } else {
        window.scrollTo({ top: 0 });
      }
    </script>

    <script>
      // Scroll-reveal: tag every top-level section and slide it up when it
      // enters the viewport. Stagger siblings slightly via --reveal-delay.
      const sections = document.querySelectorAll<HTMLElement>('main section');
      sections.forEach((el, i) => {
        el.setAttribute('data-reveal', '');
        el.style.setProperty('--reveal-delay', `${Math.min(i, 3) * 60}ms`);
      });

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        sections.forEach((el) => io.observe(el));
      } else {
        sections.forEach((el) => el.classList.add('reveal-visible'));
      }
    </script>
  </body>
</html>
