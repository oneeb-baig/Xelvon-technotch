---
import Icon from './icons/Icon.astro';

const serviceTracks = [
  {
    title: 'Software & Web',
    description: 'Modern web applications, custom software, and digital products.',
    href: '/services#software',
    icon: 'code2',
  },
  {
    title: 'Cyber Security',
    description: 'Detect, contain, recover, and harden enterprise systems.',
    href: '/services#cybersecurity',
    icon: 'shield',
  },
  {
    title: 'Infrastructure',
    description: 'Cloud migrations, DevOps pipelines, and network architecture.',
    href: '/services#cloud',
    icon: 'cloud',
  },
  {
    title: 'Managed IT',
    description: 'Round-the-clock technical helpdesk and server monitoring.',
    href: '/services#support',
    icon: 'headphones',
  },
];

const desktopLinkBase =
  'inline-flex h-[42px] items-center justify-center whitespace-nowrap rounded-[5px] border border-[#c8c8c8] bg-white px-[18px] text-[13px] font-normal leading-none text-[#1f1f1f] transition-colors duration-150 hover:border-[#0f6b2c] hover:text-[#0f6b2c] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0f6b2c]';

const tabletLinkBase =
  'inline-flex h-[34px] items-center justify-center whitespace-nowrap rounded-[4px] border border-[#c8c8c8] bg-white px-[12px] text-[11px] font-normal leading-none text-[#1f1f1f] transition-colors duration-150 hover:border-[#0f6b2c] hover:text-[#0f6b2c] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0f6b2c]';

const pathname = Astro.url.pathname;
const isActive = (path: string) => pathname === path;
const isServicesActive = pathname.startsWith('/services');
---

<header class="xelvon-navbar sticky top-0 z-50 w-full bg-white">
  {/* Main Header */}
  <div class="xelvon-navbar-inner mx-auto flex h-[60px] w-full max-w-[1440px] items-center justify-between px-[16px] md:h-[58px] md:px-[24px] lg:h-[76px] lg:px-[36px]">
    {/* Logo */}
    <a href="/" aria-label="XELVON Home" class="flex h-full shrink-0 items-center">
      <picture>
        <source srcset="/assets/xelvon_logo.webp" type="image/webp" />
        <img
          src="/assets/xelvon_logo_raw_1.png"
          alt="XELVON Private Limited"
          width="1143"
          height="348"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="xelvon-logo block h-[40px] w-auto max-w-[155px] object-contain md:h-[38px] md:max-w-[145px] lg:h-[58px] lg:max-w-[230px]"
        />
      </picture>
    </a>

    {/* Right-Aligned Desktop Navigation & Action Buttons (lg+) */}
    <div class="hidden items-center gap-[14px] lg:flex">
      <nav aria-label="Main navigation" class="flex items-center gap-[14px]">
        {/* Services */}
        <div class="group relative">
          <a
            href="/services"
            aria-haspopup="true"
            class={`${desktopLinkBase} ${isServicesActive ? 'border-[#0f6b2c] text-[#0f6b2c]' : ''}`}
          >
            Services
          </a>

          {/* Services Dropdown */}
          <div class="invisible absolute left-0 top-full z-50 w-[300px] pt-[8px] opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
            <div class="overflow-hidden rounded-[5px] border border-[#e2e6e1] bg-white p-2 shadow-[0_8px_24px_rgba(0,0,0,0.13)]">
              <div class="border-b border-[#edf0ec] px-2 pb-2 pt-1 text-[10px] font-semibold uppercase tracking-wider text-[#0f6b2c]">
                Our Core Capabilities
              </div>

              {serviceTracks.map(({ title, description, href, icon }) => (
                <a
                  href={href}
                  class="group/item flex items-start gap-3 rounded-[4px] px-2 py-2.5 transition-colors hover:bg-[#f3f5f1]"
                >
                  <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded bg-[#f0f5ef] text-[#0f6b2c] transition-colors group-hover/item:bg-[#0f6b2c] group-hover/item:text-white">
                    <Icon name={icon} size={17} strokeWidth={1.8} />
                  </span>

                  <span class="min-w-0">
                    <span class="block text-[11px] font-semibold text-[#171717] group-hover/item:text-[#0f6b2c]">
                      {title}
                    </span>

                    <span class="mt-1 block text-[9px] leading-relaxed text-[#666]">
                      {description}
                    </span>
                  </span>
                </a>
              ))}

              <a
                href="/services"
                class="flex items-center justify-between border-t border-[#edf0ec] px-2 pt-2 text-[10px] font-semibold text-[#0f6b2c]"
              >
                Explore all services
                <span>→</span>
              </a>
            </div>
          </div>
        </div>

        {/* Cyber Security */}
        <a
          href="/services#cybersecurity"
          data-cyber-link
          class={`${desktopLinkBase}`}
        >
          Cyber Security
        </a>

        {/* About */}
        <a
          href="/about"
          class={`${desktopLinkBase} ${isActive('/about') ? 'border-[#0f6b2c] text-[#0f6b2c]' : ''}`}
        >
          About
        </a>

        {/* Contact */}
        <a
          href="/contact"
          class={`${desktopLinkBase} ${isActive('/contact') ? 'border-[#0f6b2c] text-[#0f6b2c]' : ''}`}
        >
          Contact
        </a>
      </nav>

      {/* Call */}
      <a href="tel:+924237897420" class={desktopLinkBase} aria-label="Call XELVON">
        Call
      </a>

      {/* WhatsApp */}
      <a
        href="https://wa.me/923334333611"
        target="_blank"
        rel="noopener noreferrer"
        class={desktopLinkBase}
        aria-label="Contact XELVON on WhatsApp"
      >
        WhatsApp
      </a>

      {/* Get a Quote */}
      <a href="/contact" class="xelvon-quote-button">
        Get a quote
      </a>
    </div>

    {/* Tablet Action Buttons + Mobile Hamburger (< lg) */}
    <div class="flex items-center gap-[8px] lg:hidden">
      <div class="hidden shrink-0 items-center gap-[8px] md:flex">
        <a href="tel:+924237897420" class={tabletLinkBase} aria-label="Call XELVON">
          Call
        </a>

        <a
          href="https://wa.me/923334333611"
          target="_blank"
          rel="noopener noreferrer"
          class={tabletLinkBase}
          aria-label="Contact XELVON on WhatsApp"
        >
          WhatsApp
        </a>

        <a href="/contact" class="xelvon-quote-button xelvon-quote-button--tablet">
          Get a quote
        </a>
      </div>

      <button
        type="button"
        id="xelvon-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="xelvon-mobile-menu"
        class="flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-[6px] border border-[#9e9e9e] bg-white text-[#171717] transition-colors hover:border-[#0f6b2c] hover:text-[#0f6b2c] md:h-[34px] md:w-[34px] md:rounded-[4px] md:border-[#c8c8c8]"
      >
        <span data-icon-open><Icon name="menu" size={20} /></span>
        <span data-icon-close class="hidden"><Icon name="x" size={20} /></span>
      </button>
    </div>
  </div>

  {/* Mobile / Tablet Menu */}
  <div
    id="xelvon-mobile-menu"
    class="absolute left-0 right-0 top-full z-50 hidden border-b border-[#dfe5dc] bg-white shadow-[0_8px_18px_rgba(0,0,0,0.12)] lg:hidden"
  >
    <nav aria-label="Mobile navigation" class="mx-auto max-w-[1440px] px-4 py-3 md:px-6">
      {/* Home */}
      <a
        href="/"
        class={`block border-b border-[#eeeeee] py-3 text-[13px] font-medium ${isActive('/') ? 'text-[#0f6b2c]' : 'text-[#171717]'}`}
      >
        Home
      </a>

      {/* Services */}
      <div class="border-b border-[#eeeeee]">
        <div class="flex items-center justify-between">
          <a
            href="/services"
            class={`py-3 text-[13px] font-medium ${isServicesActive ? 'text-[#0f6b2c]' : 'text-[#171717]'}`}
          >
            Services
          </a>

          <button
            type="button"
            id="xelvon-services-toggle"
            aria-expanded="false"
            aria-label="Toggle services"
            class="flex h-9 w-9 items-center justify-center text-[#0f6b2c]"
          >
            <span data-chevron class="block transition-transform duration-200">
              <Icon name="chevron-down" size={18} />
            </span>
          </button>
        </div>

        <div id="xelvon-services-submenu" class="mb-3 ml-2 hidden border-l-2 border-[#b0da19] pl-3">
          {serviceTracks.map(({ title, href }) => (
            <a
              href={href}
              class="block py-2 text-[12px] text-[#555] hover:text-[#0f6b2c]"
            >
              {title}
            </a>
          ))}

          <a href="/services" class="block py-2 text-[12px] font-semibold text-[#0f6b2c]">
            Explore all services →
          </a>
        </div>
      </div>

      {/* Cyber Security */}
      <a
        href="/services#cybersecurity"
        data-cyber-link-mobile
        class={`block border-b border-[#eeeeee] py-3 text-[13px] font-medium ${isServicesActive ? 'text-[#0f6b2c]' : 'text-[#171717]'}`}
      >
        Cyber Security
      </a>

      {/* About */}
      <a
        href="/about"
        class={`block border-b border-[#eeeeee] py-3 text-[13px] font-medium ${isActive('/about') ? 'text-[#0f6b2c]' : 'text-[#171717]'}`}
      >
        About
      </a>

      {/* Contact */}
      <a
        href="/contact"
        class={`block py-3 text-[13px] font-medium ${isActive('/contact') ? 'text-[#0f6b2c]' : 'text-[#171717]'}`}
      >
        Contact
      </a>

      {/* Mobile Call / WhatsApp */}
      <div class="mt-2 grid grid-cols-2 gap-2 border-t border-[#eeeeee] pt-3 md:hidden">
        <a
          href="tel:+924237897420"
          class="flex h-10 items-center justify-center rounded-[5px] border border-[#c8c8c8] text-[13px] font-medium text-[#171717]"
        >
          Call
        </a>

        <a
          href="https://wa.me/923334333611"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-10 items-center justify-center rounded-[5px] border border-[#c8c8c8] text-[13px] font-medium text-[#171717]"
        >
          WhatsApp
        </a>
      </div>

      {/* Mobile Quote */}
      <div class="mt-3 md:hidden">
        <a href="/contact" class="xelvon-quote-button w-full">
          Get a quote
        </a>
      </div>
    </nav>
  </div>

  {/* Header Styling */}
  <style>
    .xelvon-navbar {
      box-sizing: border-box;
      border-bottom: 2px solid #0f6b2c;
      background: #ffffff;
    }

    @media (min-width: 768px) {
      .xelvon-navbar {
        border: 1.5px solid #0f6b2c;
      }
    }

    .xelvon-navbar-inner {
      box-sizing: border-box;
    }

    .xelvon-logo {
      display: block;
      object-fit: contain;
    }

    .xelvon-quote-button {
      display: inline-flex;
      height: 42px;
      min-width: 142px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
      border: 1px solid #0f6b2c;
      border-radius: 5px;
      background: #0f6b2c;
      padding: 0 24px;
      color: #ffffff;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 13px;
      font-weight: 600;
      line-height: 1;
      transition: background-color 150ms ease;
    }

    .xelvon-quote-button--tablet {
      height: 34px;
      min-width: 105px;
      border-radius: 4px;
      padding: 0 14px;
      font-size: 11px;
    }

    .xelvon-quote-button:hover {
      background: #0b5322;
    }

    .xelvon-quote-button:focus-visible {
      outline: 2px solid #0f6b2c;
      outline-offset: 2px;
    }

    @media (max-width: 767px) {
      .xelvon-navbar-inner {
        min-height: 60px;
      }

      .xelvon-quote-button {
        height: 40px;
      }
    }

    @media (min-width: 768px) and (max-width: 1023px) {
      .xelvon-navbar-inner {
        min-height: 58px;
      }
    }

    @media (min-width: 1024px) {
      .xelvon-navbar-inner {
        min-height: 76px;
      }
    }
  </style>
</header>

<script>
  const toggle = document.getElementById('xelvon-menu-toggle');
  const menu = document.getElementById('xelvon-mobile-menu');
  const servicesToggle = document.getElementById('xelvon-services-toggle');
  const servicesSubmenu = document.getElementById('xelvon-services-submenu');
  const iconOpen = toggle?.querySelector('[data-icon-open]');
  const iconClose = toggle?.querySelector('[data-icon-close]');
  const chevron = servicesToggle?.querySelector('[data-chevron]');

  const setMenuOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    if (!open) setServicesOpen(false);
  };

  const setServicesOpen = (open: boolean) => {
    servicesSubmenu?.classList.toggle('hidden', !open);
    servicesToggle?.setAttribute('aria-expanded', String(open));
    chevron?.classList.toggle('rotate-180', open);
  };

  toggle?.addEventListener('click', () => {
    setMenuOpen(menu?.classList.contains('hidden') ?? false);
  });

  servicesToggle?.addEventListener('click', () => {
    setServicesOpen(servicesSubmenu?.classList.contains('hidden') ?? false);
  });

  // Close menus with Escape
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setMenuOpen(false);
    }
  });

  // Close mobile menus after tapping any link inside the menu
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  // Hash-based active state for the Cyber Security links (not knowable server-side)
  if (window.location.pathname === '/services' && window.location.hash === '#cybersecurity') {
    document.querySelectorAll('[data-cyber-link]').forEach((el) => {
      el.classList.add('border-[#0f6b2c]', 'text-[#0f6b2c]');
    });
    document.querySelectorAll('[data-cyber-link-mobile]').forEach((el) => {
      el.classList.remove('text-[#171717]');
      el.classList.add('text-[#0f6b2c]');
    });
  }
</script>
