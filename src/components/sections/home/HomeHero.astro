---
import Icon from '../../icons/Icon.astro';
import SectionEyebrow from '../SectionEyebrow.astro';
import { TRUST_TICKS } from '../../../data/content';
---

<section class="relative w-full overflow-hidden bg-white">
  {/* Mobile & Tablet Translucent Background Hero Photo (< lg) */}
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[360px] sm:h-[430px] lg:hidden"
    aria-hidden="true"
  >
    <img
      src="/assets/d2_hero.webp"
      alt=""
      width="1218"
      height="864"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-center opacity-25 sm:opacity-30"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-white/75 via-white/65 to-white"></div>
    {/* Bottom-right lime accent curve on tablet/mobile */}
    <img
      src="/assets/d2_svg_1.svg"
      alt=""
      class="absolute bottom-6 right-0 w-[68px] opacity-85 sm:w-[90px]"
    />
  </div>

  {/* Desktop Right-Side Curved Photo Collage (lg+) */}
  <div
    class="pointer-events-none absolute right-0 top-0 hidden h-[520px] w-[54%] max-w-[780px] lg:block xl:h-[550px]"
    aria-hidden="true"
  >
    {/* Top-Right Dark Green Corner Triangle */}
    <img
      src="/assets/d2_svg_3.svg"
      alt=""
      class="absolute right-0 top-0 z-20 w-[38px]"
    />

    {/* Masked Office Image */}
    <div
      class="relative h-full w-full overflow-hidden"
      style="border-bottom-left-radius: 260px; border-top-left-radius: 260px;"
    >
      <img
        src="/assets/d2_hero.webp"
        alt="XELVON engineering team collaborating in Lahore office"
        width="1218"
        height="864"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover object-center"
      />
      {/* Left Soft White Fade */}
      <div class="absolute inset-y-0 left-0 w-36 bg-gradient-to-r from-white via-white/75 to-transparent"></div>
    </div>

    {/* Bottom-Right Curved Green & Lime Ribbons */}
    <img
      src="/assets/d2_svg_2.svg"
      alt=""
      class="absolute bottom-[36px] right-0 z-20 w-[105px]"
    />
    <img
      src="/assets/d2_svg_1.svg"
      alt=""
      class="absolute bottom-[6px] right-0 z-20 w-[86px]"
    />
  </div>

  {/* Main Hero Foreground Content */}
  <div class="relative z-10 mx-auto w-full max-w-site px-5 pb-14 pt-8 sm:px-8 sm:pb-16 sm:pt-12 lg:px-14 lg:pb-24 lg:pt-16">
    <div class="max-w-[540px]">
      <SectionEyebrow label="CYBER SECURITY · CLOUD · SOFTWARE · LAHORE" />

      <h1 class="mt-4 font-heading text-[40px] font-bold leading-[1.08] tracking-[-0.02em] text-xelvon-dark sm:text-[52px] lg:text-[58px]">
        We secure, build
        <br />
        and run your
        <br />
        <span class="relative inline-block pb-3 text-[#286B31]">
          <span class="relative z-10">technology</span>

          <svg
            width="453"
            height="122"
            viewBox="0 0 453 122"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-[22px] -left-[10px] z-0 h-auto w-[136%] max-w-none overflow-visible"
          >
            <path
              d="M299.573 105.278L300.084 106.767L273.595 113.511L233.563 118.418L199.514 120.709L158.526 121.68L107.458 120.864L61.3197 117.524C54.8585 116.683 49.4742 115.829 45.5331 115.155C45.5331 115.155 29.4135 112.411 19.8216 109.213C16.2469 108.022 12.8164 106.508 12.5722 106.391C11.1175 105.799 9.69405 105.107 8.30913 104.32C6.23312 103.025 2.03668 100.436 0.537949 95.2581C-1.38264 88.5523 2.42525 82.1314 2.83601 81.4452C3.5388 80.3029 4.30263 79.2133 5.12295 78.1829C6.24192 76.7771 7.45591 75.4784 8.75321 74.2993C11.4045 71.8559 14.1653 69.5786 17.024 67.477L22.6858 68.0595C21.2981 69.0563 19.3553 70.5063 17.135 72.3704C13.4603 75.3867 11.5841 76.9013 10.1298 78.7526C8.47566 80.8109 3.67973 86.7788 5.03414 93.368C5.93338 97.6919 9.58583 100.475 10.8292 101.459C12.0348 102.37 13.3139 103.142 14.6482 103.763C16.8905 104.792 19.1856 105.657 21.5202 106.352C23.2187 106.922 24.2623 107.272 25.6389 107.647C29.802 108.942 33.6321 109.77 36.8627 110.404C38.7611 110.767 48.142 112.566 61.675 113.667C67.8031 114.159 72.9654 114.366 76.3736 114.508C79.7819 114.65 83.0347 114.728 86.3652 114.78C93.7256 114.896 100.797 114.78 107.68 114.56C127.663 114.223 148.446 113.265 169.983 111.44C179.664 110.629 189.167 109.688 198.492 108.618C209.483 107.039 219.708 105.602 229.044 104.32C244.442 102.184 248.539 101.731 254.878 101.42C263.024 101 271.185 101.247 279.302 102.158C281.711 102.469 286.862 103.207 291.969 104.022C295.11 104.514 297.741 104.967 299.573 105.278Z"
              fill="url(#paint0_linear_1_2678)"
            ></path>
            <path
              d="M348.428 51.8633C357.957 46.2018 367.775 41.1925 377.83 36.8624C381.038 35.4783 384.188 34.2007 387.282 33.0295C408.377 23.9034 425.453 26.5956 429.471 35.6418C430.164 37.1704 431.942 42.1555 427.633 51.8633C419.736 65.0397 408.829 75.5256 396.082 82.196C390.838 85.0364 385.173 87.8997 379.106 90.5691C374.264 92.7365 369.573 94.6416 365.043 96.3299C365.726 94.1739 366.419 92.0293 367.112 89.8733C377.823 85.2117 387.823 78.6676 396.745 70.4804C401.025 66.5311 405.031 62.2139 408.728 57.5671C410.105 55.6849 414.213 49.5818 412.646 43.1024C412.48 42.4064 412.248 41.7331 411.953 41.0946C408.427 33.7025 389.854 36.7483 387.915 37.0791C384.249 37.9917 380.452 39.0641 376.554 40.3075C366.943 43.3736 357.542 47.2359 348.428 51.8633Z"
              fill="url(#paint1_linear_1_2678)"
            ></path>
            <path d="M415.522 30.927L414 38.532L420.878 38.2629L423 29.406L415.522 30.927Z" fill="#286B31"></path>
            <path d="M431.47 12.168L430.005 22.1236L439.039 21.8786L440.353 12.5132L431.47 12.168Z" fill="#286B31"></path>
            <path d="M443.649 0L442.652 9.86259L452.177 9.95563L453 0.534999L443.649 0Z" fill="#B0DA19"></path>
            <path d="M444.734 22.1236L443.802 29.7782L449.769 29.8669L450.701 22.2123L444.734 22.1236Z" fill="#B0DA19"></path>
            <defs>
              <linearGradient
                id="paint0_linear_1_2678"
                x1="0"
                y1="94.5785"
                x2="300.084"
                y2="94.5785"
                gradient-units="userSpaceOnUse"
              >
                <stop stop-color="#286B31"></stop>
                <stop offset="0.197115" stop-color="#B0DA19"></stop>
                <stop offset="0.596154" stop-color="#286B31"></stop>
                <stop offset="0.975962" stop-color="#B0DA19"></stop>
              </linearGradient>
              <linearGradient
                id="paint1_linear_1_2678"
                x1="389.428"
                y1="27.378"
                x2="389.428"
                y2="96.3299"
                gradient-units="userSpaceOnUse"
              >
                <stop stop-color="#286B31"></stop>
                <stop offset="0.471154" stop-color="#B0DA19"></stop>
                <stop offset="0.985577" stop-color="#286B31"></stop>
              </linearGradient>
            </defs>
          </svg>
        </span>
      </h1>

      <p class="mt-5 max-w-[490px] font-body text-[14.5px] leading-[1.65] text-[#2b2b2b] sm:text-[15.5px]">
        XELVON is a Lahore-based IT company that secures, builds and
        supports the systems Pakistani businesses run on, from cloud and
        custom software to AI automation, with a 24/7 help desk.
      </p>

      {/* Primary & Secondary Buttons */}
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        <a
          href="/contact"
          class="inline-flex h-[46px] w-full items-center justify-center rounded-[5px] bg-xelvon-green px-7 font-heading text-[14px] font-semibold text-white transition-colors hover:bg-xelvon-green-hover sm:w-auto"
        >
          Book a consultation →
        </a>

        <a
          href="/services"
          class="inline-flex h-[46px] w-full items-center justify-center rounded-[5px] border border-xelvon-green bg-white px-7 font-heading text-[14px] font-semibold text-xelvon-green transition-colors hover:bg-xelvon-green-light sm:w-auto"
        >
          Explore services
        </a>
      </div>

      {/* Trust Ticks */}
      <ul class="mt-7 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6 sm:gap-y-2">
        {TRUST_TICKS.map((tick) => (
          <li class="inline-flex items-center gap-2 text-[12.5px] font-medium text-[#222222]">
            <span class="flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded-full bg-xelvon-lime text-xelvon-dark">
              <Icon name="check" size={11} strokeWidth={3} />
            </span>
            <span>{tick}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
