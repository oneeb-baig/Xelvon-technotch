---
import SectionEyebrow from '../SectionEyebrow.astro';

const TECH_ITEMS = [
  { name: 'Microsoft Azure', badge: 'azure' },
  { name: 'AWS', badge: 'aws' },
  { name: 'Google Cloud', badge: 'gcloud' },
  { name: 'Dynamics 365', badge: 'dynamics' },
  { name: 'Power Platform', badge: 'power' },
  { name: 'React', badge: 'react' },
  { name: '.NET', badge: 'dotnet' },
  { name: 'Python', badge: 'python' },
  { name: 'Kubernetes', badge: 'k8s' },
  { name: 'SQL Server', badge: 'sqlserver' },
  { name: 'Docker', badge: 'docker' },
  { name: 'Linux', badge: 'linux' },
  { name: 'Alibaba Cloud', badge: 'alibaba' },
  { name: 'Oracle Cloud', badge: 'oracle' },
];

const topTwelve = TECH_ITEMS.slice(0, 12);
const bottomTwo = TECH_ITEMS.slice(12);
---

<section class="w-full bg-[#F3F5F1] py-14 sm:py-16 lg:py-20">
  <div class="mx-auto w-full max-w-site px-5 sm:px-8 lg:px-14">
    <SectionEyebrow label="TECHNOLOGY" />

    <h2 class="mt-3 font-heading text-[26px] font-bold leading-tight text-xelvon-dark sm:text-[32px] lg:text-[36px]">
      Platforms and tools our engineers work with every day
    </h2>

    {/* First 12 Tools: 2 cols mobile, 3 cols tablet, 6 cols desktop */}
    <div class="mt-9 grid grid-cols-2 gap-3.5 sm:grid-cols-3 sm:gap-4 lg:grid-cols-6">
      {topTwelve.map((tech) => (
        <div
          class="flex h-[88px] items-center justify-center rounded-[8px] border border-[#e3e7e0] bg-white px-4 transition-colors hover:border-xelvon-green/45"
        >
          {tech.badge === 'azure' && (
            <div class="flex flex-col items-center gap-2">
              <svg viewBox="0 0 36 28" class="h-8 w-9" fill="none">
                <path d="M14 2L4 24h8l9-22h-7Z" fill="#0078D4" />
                <path d="M21 6l-5 12 10 6h8L21 6Z" fill="#50E6FF" />
              </svg>
              <span class="text-[11px] font-medium text-[#444444]">Microsoft Azure</span>
            </div>
          )}
          {tech.badge === 'aws' && (
            <div class="flex flex-col items-center">
              <span class="font-heading text-[24px] font-extrabold leading-none tracking-tight text-[#232F3E]">aws</span>
              <svg viewBox="0 0 48 10" class="mt-0.5 h-3 w-14" fill="none">
                <path d="M4 2c12 7 28 7 38 0" stroke="#FF9900" stroke-width="2.6" stroke-linecap="round" />
                <path d="M39 1l4 1-2 4" stroke="#FF9900" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          )}
          {tech.badge === 'gcloud' && (
            <div class="flex flex-col items-center gap-2">
              <svg viewBox="0 0 36 26" class="h-8 w-10" fill="none">
                <path d="M11 21h15a6 6 0 0 0 1-11.9A8 8 0 0 0 11.5 7 6.5 6.5 0 0 0 11 21Z" stroke="#4285F4" stroke-width="3.2" />
                <path d="M11.5 7A8 8 0 0 1 25 8" stroke="#EA4335" stroke-width="3.2" />
                <path d="M6 15a6.5 6.5 0 0 0 5 6" stroke="#34A853" stroke-width="3.2" />
                <path d="M6 15a6.5 6.5 0 0 1 5.5-8" stroke="#FBBC05" stroke-width="3.2" />
              </svg>
              <span class="text-[11px] font-medium text-[#444444]">Google Cloud</span>
            </div>
          )}
          {tech.badge === 'dynamics' && (
            <div class="flex flex-col items-center gap-2">
              <svg viewBox="0 0 28 28" class="h-8 w-8" fill="none">
                <path d="M6 3l14 6v7L6 10V3Z" fill="#0B53CE" />
                <path d="M6 12l16 7-16 6V12Z" fill="#2B7DE9" />
              </svg>
              <span class="text-[11px] font-medium text-[#444444]">Dynamics 365</span>
            </div>
          )}
          {tech.badge === 'power' && (
            <div class="flex flex-col items-center gap-2">
              <svg viewBox="0 0 28 28" class="h-8 w-8" fill="none">
                <path d="M8 5h14l-4 9H4l4-9Z" fill="#00A88F" />
                <path d="M10 14h12l-5 9H5l5-9Z" fill="#007867" />
              </svg>
              <span class="text-[11px] font-medium text-[#444444]">Power Platform</span>
            </div>
          )}
          {tech.badge === 'react' && (
            <div class="flex flex-col items-center gap-1.5">
              <svg viewBox="0 0 32 32" class="h-8 w-8" fill="none">
                <circle cx="16" cy="16" r="2.6" fill="#00D8FF" />
                <ellipse cx="16" cy="16" rx="13" ry="5" stroke="#00D8FF" stroke-width="1.7" />
                <ellipse cx="16" cy="16" rx="13" ry="5" transform="rotate(60 16 16)" stroke="#00D8FF" stroke-width="1.7" />
                <ellipse cx="16" cy="16" rx="13" ry="5" transform="rotate(120 16 16)" stroke="#00D8FF" stroke-width="1.7" />
              </svg>
              <span class="text-[11px] font-medium text-[#444444]">React</span>
            </div>
          )}
          {tech.badge === 'dotnet' && (
            <div class="flex h-11 w-11 items-center justify-center rounded-[4px] bg-[#512BD4] font-heading text-[14px] font-bold text-white">
              .NET
            </div>
          )}
          {tech.badge === 'python' && (
            <div class="flex flex-col items-center gap-1.5">
              <svg viewBox="0 0 32 32" class="h-8 w-8" fill="none">
                <path d="M16 4c-5 0-5 2.2-5 4.5V11h5v1.2H9.5C6.8 12.2 5 14 5 17s1.8 4.8 4.5 4.8H11v-3c0-2 1.6-3.6 3.6-3.6h4.8c1.6 0 2.6-1.1 2.6-2.7V8.5C22 6.2 20.5 4 16 4Z" fill="#3776AB" />
                <path d="M16 28c5 0 5-2.2 5-4.5V21h-5v-1.2h6.5c2.7 0 4.5-1.8 4.5-4.8s-1.8-4.8-4.5-4.8H21v3c0 2-1.6 3.6-3.6 3.6h-4.8c-1.6 0-2.6 1.1-2.6 2.7v4c0 2.3 1.5 4.5 6 4.5Z" fill="#FFD43B" />
              </svg>
              <span class="text-[11px] font-medium text-[#444444]">Python</span>
            </div>
          )}
          {tech.badge === 'k8s' && (
            <div class="flex flex-col items-center gap-1.5">
              <svg viewBox="0 0 32 32" class="h-8 w-8" fill="none">
                <polygon points="16,3 27,9 29,21 21,29 11,29 3,21 5,9" fill="#326CE5" />
                <circle cx="16" cy="16" r="4.5" stroke="#ffffff" stroke-width="1.6" />
                <path d="M16 7v4.5M16 20.5V25M8 12l4 2.2M20 18.8l4 2.2M24 12l-4 2.2M12 18.8L8 21" stroke="#ffffff" stroke-width="1.5" />
              </svg>
              <span class="text-[11px] font-medium text-[#444444]">Kubernetes</span>
            </div>
          )}
          {tech.badge === 'sqlserver' && (
            <div class="flex flex-col items-center gap-1.5">
              <svg viewBox="0 0 32 26" class="h-7 w-9" fill="none">
                <ellipse cx="16" cy="6" rx="9" ry="3.5" stroke="#CC2927" stroke-width="1.9" />
                <path d="M7 6v12c0 2 4 3.5 9 3.5s9-1.5 9-3.5V6" stroke="#CC2927" stroke-width="1.9" />
                <path d="M7 12c0 2 4 3.5 9 3.5s9-1.5 9-3.5" stroke="#CC2927" stroke-width="1.6" />
              </svg>
              <span class="text-[11px] font-medium text-[#444444]">SQL Server</span>
            </div>
          )}
          {tech.badge === 'docker' && (
            <div class="flex flex-col items-center gap-1.5">
              <svg viewBox="0 0 36 26" class="h-7 w-10" fill="none">
                <rect x="8" y="9" width="4" height="3.5" fill="#2496ED" />
                <rect x="13" y="9" width="4" height="3.5" fill="#2496ED" />
                <rect x="18" y="9" width="4" height="3.5" fill="#2496ED" />
                <rect x="13" y="4.5" width="4" height="3.5" fill="#2496ED" />
                <rect x="18" y="4.5" width="4" height="3.5" fill="#2496ED" />
                <path d="M4 14h23c2.5 0 4-1.5 5-3 1 1.8.8 4.2-.8 6-2.5 3-7 5-14.2 5C9.5 22 5 18.5 4 14Z" fill="#2496ED" />
              </svg>
              <span class="text-[11px] font-medium text-[#444444]">Docker</span>
            </div>
          )}
          {tech.badge === 'linux' && (
            <div class="flex flex-col items-center gap-1.5">
              <svg viewBox="0 0 28 28" class="h-8 w-8" fill="none">
                <ellipse cx="14" cy="16" rx="7" ry="9" fill="#1b1b1b" />
                <ellipse cx="14" cy="17" rx="4.5" ry="6.5" fill="#ffffff" />
                <circle cx="14" cy="8" r="4.5" fill="#1b1b1b" />
                <polygon points="11,10 17,10 14,12.5" fill="#F59E0B" />
                <ellipse cx="10" cy="24" rx="3" ry="1.5" fill="#F59E0B" />
                <ellipse cx="18" cy="24" rx="3" ry="1.5" fill="#F59E0B" />
              </svg>
              <span class="text-[11px] font-medium text-[#444444]">Linux</span>
            </div>
          )}
        </div>
      ))}
    </div>

    {/* Last 2 Tools: Centered on desktop, 2-col row on mobile/tablet */}
    <div class="mt-3.5 grid grid-cols-2 gap-3.5 sm:mx-auto sm:mt-4 sm:max-w-[440px] sm:gap-4">
      {bottomTwo.map((tech) => (
        <div
          class="flex h-[88px] items-center justify-center rounded-[8px] border border-[#e3e7e0] bg-white px-4 transition-colors hover:border-xelvon-green/45"
        >
          {tech.badge === 'alibaba' && (
            <div class="flex flex-col items-center gap-1.5">
              <svg viewBox="0 0 40 20" class="h-6 w-12" fill="none">
                <path d="M12 4H6l-3 6 3 6h6M28 4h6l3 6-3 6h-6M14 10h12" stroke="#FF6A00" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="text-[11px] font-semibold text-[#FF6A00]">Alibaba Cloud</span>
            </div>
          )}
          {tech.badge === 'oracle' && (
            <div class="flex items-center justify-center">
              <div class="flex h-9 w-20 items-center justify-center rounded-full border-[3px] border-[#C74634] px-3">
                <span class="text-[9px] font-bold uppercase tracking-wider text-[#C74634]">CLOUD</span>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
