---
import SectionEyebrow from './SectionEyebrow.astro';

const REGISTRATIONS = [
  {
    id: 'secp',
    fullName: 'Securities & Exchange Commission of Pakistan',
    emblemClass: 'h-[74px] w-[74px] sm:h-[82px] sm:w-[82px]',
    emblem: 'secp',
  },
  {
    id: 'fbr',
    fullName: 'Federal Board of Revenue Pakistan',
    emblemClass: 'h-[68px] w-[108px] sm:h-[74px] sm:w-[118px]',
    emblem: 'fbr',
  },
  {
    id: 'pasha',
    fullName: 'Pakistan Software Houses Association',
    emblemClass: 'h-[66px] w-[112px] sm:h-[72px] sm:w-[122px]',
    emblem: 'pasha',
  },
  {
    id: 'lcci',
    fullName: 'The Lahore Chamber of Commerce & Industry',
    emblemClass: 'h-[74px] w-[74px] sm:h-[82px] sm:w-[82px]',
    emblem: 'lcci',
  },
  {
    id: 'tech-destination',
    fullName: 'PSEB · Tech Destination Pakistan',
    emblemClass: 'h-[66px] w-[118px] sm:h-[72px] sm:w-[128px]',
    emblem: 'tech',
  },
  {
    id: 'pra',
    fullName: 'Punjab Revenue Authority',
    emblemClass: 'h-[68px] w-[96px] sm:h-[74px] sm:w-[104px]',
    emblem: 'pra',
  },
  {
    id: 'eobi',
    fullName: "Employees' Old-Age Benefits Institution",
    emblemClass: 'h-[74px] w-[74px] sm:h-[82px] sm:w-[82px]',
    emblem: 'eobi',
  },
  {
    id: 'pessi',
    fullName: 'Punjab Employees Social Security Institution',
    emblemClass: 'h-[74px] w-[74px] sm:h-[82px] sm:w-[82px]',
    emblem: 'pessi',
  },
];
---

<section class="w-full bg-white py-14 sm:py-16 lg:py-20">
  <div class="mx-auto w-full max-w-site px-5 sm:px-8 lg:px-14">
    <SectionEyebrow label="REGISTRATIONS & AFFILIATIONS" />

    <h2 class="mt-3 font-heading text-[26px] font-bold leading-tight text-xelvon-dark sm:text-[32px] lg:text-[36px]">
      Registered and accountable in Pakistan
    </h2>

    {/* 2 cols on mobile, 4 cols on tablet & desktop */}
    <div class="mx-auto mt-10 grid max-w-[880px] grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-5">
      {REGISTRATIONS.map((item) => (
        <div
          title={item.fullName}
          aria-label={item.fullName}
          class="flex aspect-square items-center justify-center rounded-[6px] border border-[#ebebeb] bg-white p-4 shadow-[0_1px_3px_rgba(0,0,0,0.03)] transition-all duration-200 hover:border-xelvon-green/40 hover:shadow-md"
        >
          {item.emblem === 'secp' && (
            <svg viewBox="0 0 120 120" class={item.emblemClass} fill="none">
              <circle cx="60" cy="54" r="36" stroke="#1b1b1b" stroke-width="2.2" stroke-dasharray="3 2" />
              <circle cx="60" cy="54" r="29" stroke="#1b1b1b" stroke-width="1.5" />
              <path d="M55 34a7 7 0 1 0 6 10.5 5.5 5.5 0 1 1-6-10.5Z" fill="#1b1b1b" />
              <polygon points="64,34 65,36.5 67.5,36.5 65.5,38 66.2,40.5 64,39 61.8,40.5 62.5,38 60.5,36.5 63,36.5" fill="#1b1b1b" />
              <line x1="60" y1="44" x2="60" y2="70" stroke="#1b1b1b" stroke-width="2" />
              <line x1="44" y1="51" x2="76" y2="51" stroke="#1b1b1b" stroke-width="1.8" />
              <path d="M40 59h8l-4-8-4 8Zm32 0h8l-4-8-4 8Z" fill="#1b1b1b" />
              <path d="M50 70h20" stroke="#1b1b1b" stroke-width="2.2" stroke-linecap="round" />
              <text x="60" y="106" text-anchor="middle" fill="#111111" font-size="13" font-weight="700" font-family="Inter, sans-serif" letter-spacing="1.5">
                SECP
              </text>
            </svg>
          )}
          {item.emblem === 'fbr' && (
            <svg viewBox="0 0 150 110" class={item.emblemClass} fill="none">
              <path d="M18 58C45 43 105 43 132 58" stroke="#1b1b1b" stroke-width="2.2" stroke-linecap="round" />
              <polygon points="75,26 78,43 94,46 78,49 75,66 72,49 56,46 72,43" fill="#1b1b1b" />
              <text x="75" y="76" text-anchor="middle" fill="#111111" font-size="25" font-weight="800" font-style="italic" font-family="Inter, sans-serif" letter-spacing="1">
                FBR
              </text>
              <text x="75" y="90" text-anchor="middle" fill="#333333" font-size="8.5" font-weight="700" font-family="Inter, sans-serif" letter-spacing="2.2">
                PAKISTAN
              </text>
            </svg>
          )}
          {item.emblem === 'pasha' && (
            <svg viewBox="0 0 150 100" class={item.emblemClass} fill="none">
              <text x="75" y="54" text-anchor="middle" fill="#111111" font-size="27" font-weight="800" font-family="Inter, sans-serif" letter-spacing="0.5">
                P@SHA
              </text>
              <text x="75" y="68" text-anchor="middle" fill="#333333" font-size="6.6" font-weight="600" font-family="Inter, sans-serif" letter-spacing="0.8">
                PAKISTAN IT INDUSTRY ASSOCIATION
              </text>
            </svg>
          )}
          {item.emblem === 'lcci' && (
            <svg viewBox="0 0 120 120" class={item.emblemClass} fill="none">
              <circle cx="60" cy="58" r="32" stroke="#1b1b1b" stroke-width="3.5" stroke-dasharray="6 4" />
              <circle cx="60" cy="58" r="25" stroke="#1b1b1b" stroke-width="1.4" />
              <path d="M56 76L58.5 38H61.5L64 76H56Z" fill="#1b1b1b" />
              <path d="M51 76H69V80H51V76Z" fill="#1b1b1b" />
              <circle cx="60" cy="34" r="2.2" fill="#1b1b1b" />
              <text x="60" y="106" text-anchor="middle" fill="#111111" font-size="11" font-weight="700" font-family="Inter, sans-serif" letter-spacing="1.4">
                LCCI
              </text>
            </svg>
          )}
          {item.emblem === 'tech' && (
            <svg viewBox="0 0 160 100" class={item.emblemClass} fill="none">
              <path d="M22 36H44V58L37 51V43H29L22 36Z" fill="#1b1b1b" />
              <path d="M18 46H34V62L28 56V52H24L18 46Z" fill="#4b5563" />
              <text x="52" y="47" fill="#111111" font-size="12.5" font-weight="800" font-family="Inter, sans-serif">
                TECH
              </text>
              <text x="52" y="57" fill="#333333" font-size="9.5" font-weight="600" font-family="Inter, sans-serif">
                destiNATION
              </text>
              <text x="52" y="70" fill="#111111" font-size="13.5" font-weight="800" font-family="Inter, sans-serif" letter-spacing="0.5">
                PAKISTAN
              </text>
            </svg>
          )}
          {item.emblem === 'pra' && (
            <svg viewBox="0 0 140 110" class={item.emblemClass} fill="none">
              <text x="70" y="60" text-anchor="middle" fill="#111111" font-size="38" font-weight="900" font-family="Source Sans 3, sans-serif" letter-spacing="-1">
                PRA
              </text>
              <rect x="26" y="66" width="88" height="17" fill="#111111" />
              <text x="70" y="74" text-anchor="middle" fill="#ffffff" font-size="6.4" font-weight="700" font-family="Inter, sans-serif" letter-spacing="0.6">
                PUNJAB REVENUE
              </text>
              <text x="70" y="81" text-anchor="middle" fill="#ffffff" font-size="6.4" font-weight="700" font-family="Inter, sans-serif" letter-spacing="0.9">
                AUTHORITY
              </text>
            </svg>
          )}
          {item.emblem === 'eobi' && (
            <svg viewBox="0 0 120 120" class={item.emblemClass} fill="none">
              <path d="M36 82C26 70 26 48 38 35M84 82C94 70 94 48 82 35" stroke="#1b1b1b" stroke-width="2.4" stroke-linecap="round" />
              <path d="M57 24a6 6 0 1 0 5 9 4.8 4.8 0 1 1-5-9Z" fill="#1b1b1b" />
              <path d="M44 42H76V64C76 74 60 82 60 82C60 82 44 74 44 64V42Z" stroke="#1b1b1b" stroke-width="2" />
              <rect x="48" y="55" width="24" height="11" fill="#1b1b1b" />
              <text x="60" y="63" text-anchor="middle" fill="#ffffff" font-size="8.5" font-weight="800" font-family="Inter, sans-serif">
                EOBI
              </text>
            </svg>
          )}
          {item.emblem === 'pessi' && (
            <svg viewBox="0 0 120 120" class={item.emblemClass} fill="none">
              <path d="M34 86C22 72 23 48 37 33M86 86C98 72 97 48 83 33" stroke="#1b1b1b" stroke-width="2.8" stroke-linecap="round" stroke-dasharray="4 3" />
              <path d="M57 25a5.5 5.5 0 1 0 4.8 8.2 4.3 4.3 0 1 1-4.8-8.2Z" fill="#1b1b1b" />
              <text x="60" y="55" text-anchor="middle" fill="#111111" font-size="14" font-weight="800" font-family="Inter, sans-serif" letter-spacing="1">
                PE
              </text>
              <text x="60" y="70" text-anchor="middle" fill="#111111" font-size="14" font-weight="800" font-family="Inter, sans-serif" letter-spacing="1">
                SSI
              </text>
              <path d="M42 78H78L73 85H47L42 78Z" fill="#1b1b1b" />
              <text x="60" y="83.5" text-anchor="middle" fill="#ffffff" font-size="6" font-weight="700" font-family="Inter, sans-serif">
                PUNJAB
              </text>
            </svg>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
